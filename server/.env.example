# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/Intern-App

# Separate database for backups (routes/backupRoutes.js)
BACKUP_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/Intern-App-Backup

# Redis for rate limiting (optional; rate limiting disabled if unset)
REDIS_URL=rediss://default:password@host:6379

# Secret for Vercel cron-triggered backup routes
CRON_SECRET=your-cron-secret

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth client ID from Google Cloud Console; same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Google API key (Drive API enabled) - used to read public files when a custodian
# moves one into their Saviour Drive. Restrict it to the Drive API. Optional: the
# one-click move is simply unavailable if unset (manual relink still works).
GOOGLE_API_KEY=your-google-api-key

# ImgBB (Image Upload)
IMGBB_API_KEY=your-imgbb-api-key

# Frontend URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Super Admins (comma-separated emails; enrollment kept for existing accounts)
SUPER_ADMIN_EMAILS=name_x@cs.iitr.ac.in,other_y@cs.iitr.ac.in
SUPER_ADMIN_ENROLLMENT=23114001
