# For local development
VITE_API_URL=http://localhost:5000/api

# For Vercel deployment (same domain), use:
# VITE_API_URL=/api

# Google Sign-In OAuth client ID (same as server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Google API key (Drive API + Picker API enabled) - powers "pick from Drive" and
# the custodian one-click move. Optional: those features hide themselves if unset.
VITE_GOOGLE_API_KEY=your-google-api-key
